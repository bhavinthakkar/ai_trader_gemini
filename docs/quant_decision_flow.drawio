  <diagram id="quant-decision-flow" name="Deterministic Quant &amp; ML Decision Pipeline">
    <mxGraphModel dx="1300" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;font style='font-size: 18px; font-weight: bold;'&gt;⚡ ai_trader_gemini: Quantitative Scoring &amp; Compliance Decision Architecture&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 12px; color: #94A3B8;'&gt;Deterministic 5-Pillar Quant + Quality/Vol Guard + 20% ML Hybrid (stock_ml) + Compliance Safety Gates&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1200" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="TRACK A: DETERMINISTIC QUANT ENGINE" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#4338CA;strokeColor=#3730A3;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="365" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="TRACK B: POINT-IN-TIME STOCK ML (stock_ml)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="425" y="110" width="365" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="TRACK C: QUALITATIVE RAG &amp; LLM ADVISOR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="410" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;&lt;font color='#3730A3'&gt;Market &amp; Technical Data Feeds&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• Daily OHLCV Price Action, EMA20, EMA50, EMA200&lt;br/&gt;• RSI-14, 5-Day Velocity, ATR(14), RVOL(20d)&lt;br/&gt;• SPDR Sector ETFs (XLK, XLC, etc.) &amp; SPY Benchmark" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#818CF8;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=12;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="155" width="365" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;&lt;font color='#312E81'&gt;Stage A: Deterministic 5-Pillar Scores (0–100)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;1. Historical Trend (25%):&lt;/b&gt; EMA alignment &amp; RSI velocity&lt;br/&gt;• &lt;b&gt;2. Sector Relative (20%):&lt;/b&gt; 5d/20d/60d vs Sector ETF&lt;br/&gt;• &lt;b&gt;3. Market Alpha (20%):&lt;/b&gt; Trailing 5d return vs SPY benchmark&lt;br/&gt;• &lt;b&gt;4. Valuation History (15%):&lt;/b&gt; P/E &amp; EV/EBITDA vs 3Y/5Y medians&lt;br/&gt;• &lt;b&gt;5. Peer Valuation (20%):&lt;/b&gt; Multiples vs direct industry peers&lt;br/&gt;&lt;font color='#4F46E5'&gt;&lt;i&gt;Dynamic Re-weighting: W_A = Σ w_i across measured pillars&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#818CF8;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=12;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="255" width="365" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;&lt;font color='#065F46'&gt;Stage B: Financial Quality &amp; Value-Trap Guard&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• Balance Sheet Solvency: Net Debt/EBITDA, OCF Margin&lt;br/&gt;• &lt;font color='#DC2626'&gt;&lt;b&gt;Value-Trap Penalty (-15 pts):&lt;/b&gt; Cheap P/E + High Debt&lt;/font&gt;&lt;br/&gt;  &lt;font color='#DC2626'&gt;→ Directional BUYs mechanically vetoed to HOLD&lt;/font&gt;&lt;br/&gt;• &lt;font color='#059669'&gt;&lt;b&gt;Compounder Bonus (+3 pts):&lt;/b&gt; Pristine Quality ≥ 80&lt;/font&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;&lt;i&gt;Composite_adj = Raw_Composite + Bonus - Penalty&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#818CF8;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=12;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="435" width="365" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;&lt;font color='#312E81'&gt;Stage C: ATR% Volatility Factor Dampener&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• ATR% = (ATR14 / Price) × 100&lt;br/&gt;• Calm (≤1.5%): 1.00 &amp;nbsp;|&amp;nbsp; Normal (≤2.5%): 0.95&lt;br/&gt;• Elevated (≤4.0%): 0.90 &amp;nbsp;|&amp;nbsp; Extreme (&gt;4.0%): 0.85&lt;br/&gt;&lt;b&gt;&lt;font color='#4338CA'&gt;Deterministic Quant = Composite_adj × vol_factor&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#818CF8;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=12;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="575" width="365" height="95" as="geometry"/>
        </mxCell>

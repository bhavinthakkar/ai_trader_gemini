        <mxCell id="22" value="&lt;b&gt;&lt;font color='#5B21B6'&gt;16-Channel Institutional &amp; RAG Feeds&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• SEC EDGAR 10-K, 10-Q, 8-K Direct Filings &amp; Form 4&lt;br/&gt;• Official Company IR &amp; Earnings Call Transcripts&lt;br/&gt;• FastEmbed 384-dim Hybrid Multiplicative Ranking&lt;br/&gt;• Dual-Horizon: 24h/7d Catalysts vs Multi-Year Fundamentals" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=12;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="155" width="410" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;&lt;font color='#5B21B6'&gt;Multi-Agent Specialized Analysts&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• Market Agent: Technical patterns, volume &amp; RSI&lt;br/&gt;• News Agent: Catalyst scoring &amp; headline verification&lt;br/&gt;• Analyst Agent: Guidance shifts &amp; earnings revisions&lt;br/&gt;• Institutional Agent: 13F whale flow &amp; insider buys&lt;br/&gt;• Macro &amp; Risk Agents: Treasury yield curve &amp; blackouts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=12;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="270" width="410" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;&lt;font color='#4C1D95'&gt;LLM Master Trader (Moonshot Kimi-K3 / Nemotron-3)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• Synthesizes multi-agent evidence and macro narrative&lt;br/&gt;• &lt;b&gt;&lt;font color='#6D28D9'&gt;Proposes Candidate Action: [BUY / HOLD / SELL]&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• Proposes Entry Price, Stop Loss, and Target Price&lt;br/&gt;• Generates forecast_20d: OUTPERFORM / UNDERPERFORM&lt;br/&gt;&lt;font color='#B91C1C'&gt;&lt;b&gt;⚠️ ADVISORY ONLY — NOT FINAL TRADER&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;&lt;i&gt;Candidate proposal is routed into Compliance Gates for validation.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=12;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="405" width="410" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;Candidate Setup Proposal (Advisory)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;shadow=1;" vertex="1" parent="1">

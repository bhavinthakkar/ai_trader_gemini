        <mxCell id="50" value="5. DETERMINISTIC COMPLIANCE SAFETY GATES (normalize_master_trader_json)" style="swimlane;html=1;startSize=28;fillColor=#FBE9E7;strokeColor=#FFAB91;fontStyle=1;fontSize=13;fontColor=#BF360C;align=left;spacingLeft=10;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1660" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="51" value="&lt;b&gt;Deterministic Algorithmic Gatekeeper:&lt;/b&gt; The LLM proposal is strictly advisory. Every candidate trade must clear 5 hard mechanical gates. Any gate failure triggers an immediate, un-overridable veto to HOLD." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#D84315;fontStyle=2;" vertex="1" parent="50">
          <mxGeometry x="40" y="32" width="1200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="52" value="&lt;b&gt;Gate 1: BUY Floor&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Composite ≥ 60.0&lt;/b&gt;&lt;br/&gt;• (≥ 52.0 for certified Dip-Buys)&lt;br/&gt;• &lt;font color='#C62828'&gt;&lt;b&gt;Composite &lt; 60 → VETO&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E64A19;fontColor=#BF360C;fontSize=11;align=center;" vertex="1" parent="50">
          <mxGeometry x="40" y="60" width="210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="53" value="&lt;b&gt;Gate 2: Reward-to-Risk&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;RR = (Target-Entry)/(Entry-Stop)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Must be ≥ 1.20&lt;/b&gt;&lt;br/&gt;• &lt;font color='#C62828'&gt;&lt;b&gt;RR &lt; 1.20 → VETO&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E64A19;fontColor=#BF360C;fontSize=11;align=center;" vertex="1" parent="50">
          <mxGeometry x="275" y="60" width="230" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="54" value="&lt;b&gt;Gate 3: Volatility &amp; Noise&lt;/b&gt;&lt;br/&gt;• Stop outside Option Expected Move&lt;br/&gt;• Earnings Blackout (&gt; 3 days away)&lt;br/&gt;• Liquidity: RVOL ≥ 0.5x, Vol ≥ $1M&lt;br/&gt;• &lt;font color='#C62828'&gt;&lt;b&gt;Violation → VETO&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E64A19;fontColor=#BF360C;fontSize=11;align=center;" vertex="1" parent="50">
          <mxGeometry x="530" y="60" width="255" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="55" value="&lt;b&gt;Gate 4: SELL &amp; Exit Gates&lt;/b&gt;&lt;br/&gt;• Short entry requires &lt;b&gt;Composite ≤ 45.0&lt;/b&gt;&lt;br/&gt;• Long Exit: thesis intact guard if&lt;br/&gt;&lt;b&gt;Composite ≥ 70.0&lt;/b&gt; (prevents early exit)&lt;br/&gt;• Ex-Dividend blackout: ≤ 2 days blocks shorts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E64A19;fontColor=#BF360C;fontSize=11;align=center;" vertex="1" parent="50">
          <mxGeometry x="810" y="60" width="265" height="85" as="geometry"/>

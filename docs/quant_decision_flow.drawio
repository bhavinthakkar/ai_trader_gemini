        </mxCell>
        <mxCell id="16" value="&lt;b&gt;&lt;font color='#065F46'&gt;Pairwise XGBRanker (LambdaMART)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• Objective: rank:ndcg (Cross-sectional group rank)&lt;br/&gt;• Target: 20-Trading-Session Forward Excess Return&lt;br/&gt;• Out-of-Fold Purged &amp; Embargoed Cross-Validation&lt;br/&gt;• Outputs: predicted_20d_excess_return &amp; ml_rank&lt;br/&gt;&lt;b&gt;&lt;font color='#047857'&gt;• Percentile Normalized to Score: 0.0 to 100.0&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=12;fontSize=11;shadow=1;" vertex="1" parent="1">

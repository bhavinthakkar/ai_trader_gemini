        <mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6D28D9;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="24" target="25">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="29" value="&lt;b&gt;&lt;font style='font-size: 13px;' color='#92400E'&gt;STAGE D: ML HYBRID BLENDING &amp; SCOPE RESOLUTION&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color='#B45309'&gt;IN-SCOPE (Focused 25 ETF Leaders):&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font style='font-size: 13px;' color='#1E293B'&gt;Decision Composite = 0.80 × Quant + 0.20 × ML&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;• High-conviction alpha boost for modeled leaders (NVDA, AAPL, MSFT, etc.)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color='#B45309'&gt;OUT-OF-SCOPE (Unmodeled Tickers):&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font style='font-size: 13px;' color='#1E293B'&gt;Decision Composite = 1.00 × Quant (ML weight = 0.0%)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Graceful degradation; ML score set to neutral 50.0 with zero portfolio impact" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#1E293B;align=left;spacingLeft=15;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="760" width="760" height="140" as="geometry"/>
        </mxCell>

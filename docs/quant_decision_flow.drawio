        </mxCell>
        <mxCell id="34" value="DETERMINISTIC COMPLIANCE SAFETY GATES (normalize_master_trader_json)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;fontStyle=1;fontSize=13;align=center;verticalAlign=top;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="995" width="1200" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="35" value="&lt;b&gt;&lt;font color='#C2410C'&gt;Gate 1: BUY Floor&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Composite ≥ 60.0&lt;/b&gt;&lt;br/&gt;• (≥ 52.0 for Dip-Buys)&lt;br/&gt;&lt;font color='#DC2626'&gt;&lt;b&gt;Veto Action:&lt;/b&gt;&lt;br/&gt;If Composite &amp;lt; 60.0,&lt;br/&gt;candidate BUY is&lt;br/&gt;&lt;b&gt;OVERRIDDEN → HOLD&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;&lt;i&gt;Reason: composite &amp;lt; 60&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=10;fontSize=10.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="1030" width="215" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="36" value="&lt;b&gt;&lt;font color='#C2410C'&gt;Gate 2: Reward-to-Risk&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;RR Ratio ≥ 1.20&lt;/b&gt;&lt;br/&gt;• (Target-Entry)/(Entry-Stop)&lt;br/&gt;&lt;font color='#DC2626'&gt;&lt;b&gt;Veto Action:&lt;/b&gt;&lt;br/&gt;If RR &amp;lt; 1.20,&lt;br/&gt;asymmetric payoff fails;&lt;br/&gt;&lt;b&gt;OVERRIDDEN → HOLD&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;&lt;i&gt;Prevents poor setups&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=10;fontSize=10.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="1030" width="215" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="37" value="&lt;b&gt;&lt;font color='#C2410C'&gt;Gate 3: Vol &amp; Events&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;1. Option Exp Move:&lt;/b&gt;&lt;br/&gt;  Stop outside 1-SD noise&lt;br/&gt;• &lt;b&gt;2. Earnings Blackout:&lt;/b&gt;&lt;br/&gt;  Earnings &amp;gt; 3 sessions away&lt;br/&gt;• &lt;b&gt;3. Liquidity Safety:&lt;/b&gt;&lt;br/&gt;  RVOL ≥ 0.5x, 20d $Vol ≥ $1M&lt;br/&gt;&lt;font color='#DC2626'&gt;&lt;b&gt;Violation → VETO&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=10;fontSize=10.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="1030" width="230" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="38" value="&lt;b&gt;&lt;font color='#C2410C'&gt;Gate 4: SELL Symmetry&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;1. Short Breakdown:&lt;/b&gt;&lt;br/&gt;  Requires Composite ≤ 45.0&lt;br/&gt;• &lt;b&gt;2. Holding Guard:&lt;/b&gt;&lt;br/&gt;  If held &amp; Composite ≥ 70,&lt;br/&gt;  &lt;font color='#059669'&gt;early exits prevented → HOLD&lt;/font&gt;&lt;br/&gt;• &lt;b&gt;3. Ex-Div Blackout:&lt;/b&gt;&lt;br/&gt;  ≤ 2d blocks short entries" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;fontColor=#1E293B;align=left;spacingLeft=10;fontSize=10.5;shadow=1;" vertex="1" parent="1">

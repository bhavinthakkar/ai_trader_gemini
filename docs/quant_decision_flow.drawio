        <mxCell id="41" value="&lt;b&gt;In-Scope 25 Leaders Hybrid Formula:&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Decision Composite = 0.80 × Det Quant + 0.20 × ML Score&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;Provides +20% auxiliary weight to XGBRanker market-excess alpha.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFA000;fontColor=#E65100;fontSize=11;align=center;" vertex="1" parent="37">
          <mxGeometry x="410" y="40" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="&lt;b&gt;Out-of-Scope Fallback Formula:&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Decision Composite = 1.00 × Det Quant (ML Weight = 0%)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#555;'&gt;Safe degradation: ML score set to 50.0 (neutral), zero impact on composite.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFA000;fontColor=#E65100;fontSize=11;align=center;" vertex="1" parent="37">

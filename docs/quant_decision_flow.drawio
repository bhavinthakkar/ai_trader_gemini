        <mxCell id="32" value="&lt;b&gt;FINAL DECISION COMPOSITE (0.0 – 100.0)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#B45309;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;shadow=1;" vertex="1" parent="1">

[Unit]
Description=AI Trader Daily Danelfin Top 25 Best Stocks Analysis Pipeline
After=network-online.target ai-trader-api.service
Wants=network-online.target

[Service]
Type=oneshot
User={{USER}}
WorkingDirectory={{PROJECT_DIR}}
ExecStartPre=/bin/mkdir -p {{PROJECT_DIR}}/logs
ExecStart={{PROJECT_DIR}}/venv/bin/python danelfin_daily_runner.py flint --limit 25
EnvironmentFile=-{{PROJECT_DIR}}/.env
StandardOutput=append:{{PROJECT_DIR}}/logs/danelfin_daily.log
StandardError=append:{{PROJECT_DIR}}/logs/danelfin_daily.log

[Unit]
Description=AI Trader Tailscale Gateway (Serve & Funnel for Streamlit)
Documentation=https://tailscale.com/kb/1242/tailscale-serve
After=network-online.target tailscaled.service ai-trader-web.service
Wants=network-online.target tailscaled.service
PartOf=ai-trader-web.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
    for i in $(seq 1 15); do \
        if tailscale ip -4 >/dev/null 2>&1; then break; fi; \
        echo "Waiting for Tailscale network connection ($i/15)..."; \
        sleep 2; \
    done; \
    echo "⚡ Activating Tailscale Serve & Funnel on port 8501..."; \
    tailscale serve --bg 8501 || true; \
    tailscale funnel --bg 8501 || true; \
    tailscale funnel status || tailscale serve status || true'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
